{
  "name": "isms-flow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:api",
    "dev:web": "npm --workspace @apps/web run dev",
    "dev:api": "uvicorn apps/api/src/main:app --reload --port 8088",
    "build": "npm run build --workspace=web"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
